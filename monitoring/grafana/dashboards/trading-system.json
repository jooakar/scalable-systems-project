{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "HTTP requests",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "trading_web_requests_total", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Request failures",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "expr": "trading_web_request_failures_total", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Average request latency",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "rate(trading_web_request_duration_seconds_sum[1m]) / rate(trading_web_request_duration_seconds_count[1m])",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "API request rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "rate(trading_web_requests_total[1m])", "refId": "A", "legendFormat": "requests/s" }]
    },
    {
      "type": "timeseries",
      "title": "API latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "rate(trading_web_request_duration_seconds_sum[1m]) / rate(trading_web_request_duration_seconds_count[1m])",
          "refId": "A",
          "legendFormat": "seconds"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "title": "Trading System Performance",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "version": 1
}
